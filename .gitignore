# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Regenerated by tools/render_shots.py. The PNGs are committed so a reviewer can
# see the red state without running anything; these intermediate summaries are
# derived from the fixtures and would only create merge noise.
shots/*.json

# Core dumps. A crashing WebKit on a software-rendering box writes one here, and
# it is gigabytes.
src-tauri/core.*
core.*

# Python bytecode from tools/test_publish_report.py. The tests are stdlib-only
# and import publish_report, which writes this.
__pycache__/
*.pyc

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
