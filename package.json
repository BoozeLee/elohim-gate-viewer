{
  "name": "elohim-gate-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "cd src-tauri && cargo test",
    "test:gate": "cd src-tauri && ELOHIM_GATE_CMD=\"${ELOHIM_GATE_CMD:?set ELOHIM_GATE_CMD to a gate command}\" cargo test --test real_gate -- --ignored --nocapture",
    "shots": "python3 tools/render_shots.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
